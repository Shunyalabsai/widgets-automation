# Clerk test account for playground / console (never commit real values to git)
SHUNYA_TEST_EMAIL=
SHUNYA_TEST_PASSWORD=

# Contact form daily E2E — POST /api/site/send-mail with X-Automation-Secret (from Shunya, not in git)
# Email in payload must be exactly: automated-test@example.com
CONTACT_AUTOMATION_SECRET=

# Resonance homepage demo call (morning run only) — API path from backend, same or separate automation secret
# RUN_DAILY_RESONANCE_E2E=1
# RESONANCE_CALLBACK_PATH=/api/site/resonance/...
# RESONANCE_AUTOMATION_SECRET=
# RESONANCE_AUTOMATION_PHONE=+91...

